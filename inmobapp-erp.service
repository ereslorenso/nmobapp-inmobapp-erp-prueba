# Servicio para que el ERP arranque solo en un VPS Linux (Ubuntu/Debian).
# 1) Copia la carpeta a /opt/inmobapp-erp
# 2) sudo cp inmobapp-erp.service /etc/systemd/system/
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now inmobapp-erp
# 4) Ver la contraseña: sudo cat /opt/inmobapp-erp/config.json
[Unit]
Description=InmobApp ERP (servidor de prueba)
After=network.target

[Service]
WorkingDirectory=/opt/inmobapp-erp
ExecStart=/usr/bin/node server.js
Environment=PORT=8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
